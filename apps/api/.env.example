# metamorph-api environment template (copy to apps/api/.env)

# HTTP server
PORT=3001
# Public base URL where GPU containers can reach this API (webhooks, WS relay URLs)
API_PUBLIC_URL=http://localhost:3001

# PostgreSQL used by Drizzle ORM (@effect/sql-pg) and Better Auth (users, sessions, accounts, JWKS).
# Push or migrate the schema with: pnpm --filter @metamorph/api db:push (or db:generate + db:migrate)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/metamorph

# Better Auth
# Secret used for encryption/signing (min 32 chars). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of this API (OAuth callbacks are built from it)
BETTER_AUTH_URL=http://localhost:3001
# Comma-separated browser origins allowed for CORS/CSRF (e.g. apps/web)
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Google OAuth (optional: Google sign-in is enabled only when both are set)
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWTs for engine-py (EdDSA/Ed25519)
# Must match ENGINE_JWT_ISSUER in apps/engine-py. Default: BETTER_AUTH_URL
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=http://localhost:3001
JWT_EXPIRATION_TIME=15m
# Optional PKCS#8 Ed25519 PEM private key (auto-generated & stored encrypted in Postgres when unset)
ENGINE_JWT_PRIVATE_KEY=
# Optional JWKS URL injected into engine containers (e.g. <API_PUBLIC_URL>/.well-known/engine-jwks.json)
ENGINE_JWT_JWKS_URL=

# Reference Asset Object Storage (required S3-compatible storage; e.g. MinIO/LocalStack/RustFS in dev)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Engine Docker Image & Lifecycle Defaults (@metamorph/orchestrator)
ENGINE_IMAGE_REPO=metamorph-engine
ENGINE_IMAGE_TAG_FULL=full
ENGINE_IMAGE_TAG_VOICE=voice
ENGINE_IMAGE_TAG_MOCK=mock
ENGINE_STARTUP_IDLE_TIMEOUT_S=120
ENGINE_DISCONNECT_TIMEOUT_S=30
ENGINE_ALLOWED_ASSET_HOSTS=
ENGINE_AUTO_DOWNLOAD_MODELS=false
ENGINE_MODEL_VOLUME_DIR=

# Orchestrator Scheduling & Guardrails
# Comma-separated provider priority order: runpod, vastai, local
ORCHESTRATOR_PROVIDERS=runpod,vastai,local
# Set true in dev/admin environments to allow providerOverride / gpuTypeOverride on POST /sessions
ORCHESTRATOR_ALLOW_OVERRIDES=false
ORCHESTRATOR_STARTUP_TIMEOUT_S=600
ORCHESTRATOR_READINESS_POLL_INTERVAL_MS=2500
ORCHESTRATOR_MAX_SESSION_DURATION_S=7200
ORCHESTRATOR_RECONCILE_INTERVAL_S=30
ORCHESTRATOR_ORPHAN_GRACE_PERIOD_S=90
# Defaults to API_PUBLIC_URL / BETTER_AUTH_URL when unset
ORCHESTRATOR_WEBHOOK_BASE_URL=

# RunPod REST v2 Provider
RUNPOD_API_KEY=
RUNPOD_API_URL=https://api.runpod.io/v2
RUNPOD_CLOUD_TYPE=SECURE
RUNPOD_DATA_CENTER_IDS=
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_GLOBAL_VOLUME_ID=

# Vast.ai REST v0 Provider
VASTAI_API_KEY=
VASTAI_API_URL=https://console.vast.ai/api/v0
VASTAI_MAX_PRICE_PER_HR=
VASTAI_TLS_PROXY_BASE_URL=

# Local / Static Dev Engine Provider
LOCAL_ENGINE_URL=http://127.0.0.1:8000
LOCAL_ENGINE_WS_URL=
LOCAL_ENGINE_VERIFY_HEALTH=false
