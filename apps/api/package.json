{
  "name": "@metamorph/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='-r dotenv/config' node --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "NODE_OPTIONS='-r dotenv/config' node dist/index.js",
    "test": "node --test \"src/**/*.test.ts\"",
    "db:generate": "NODE_OPTIONS='-r dotenv/config' pnpm drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS='-r dotenv/config' pnpm drizzle-kit migrate",
    "db:push": "NODE_OPTIONS='-r dotenv/config' pnpm drizzle-kit push",
    "auth:schema": "NODE_OPTIONS='-r dotenv/config' pnpm dlx auth@latest generate --config src/auth.ts --output src/db/auth-schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/client-sesv2": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@effect/platform-node": "^4.1.5",
    "@effect/sql-pg": "^4.1.5",
    "@metamorph/email": "workspace:*",
    "@metamorph/orchestrator": "workspace:*",
    "@metamorph/shared": "workspace:*",
    "better-auth": "^1.7.27",
    "drizzle-orm": "1.0.0-rc.6",
    "effect": "^4.1.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.10",
    "drizzle-kit": "1.0.0-rc.6",
    "typescript": "^7.0.2"
  }
}
