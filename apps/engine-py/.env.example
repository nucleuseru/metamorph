# metamorph-engine environment template (copy to apps/engine-py/.env for local docker compose)

# Server & backend (gpu | mock)
ENGINE_HOST=0.0.0.0
ENGINE_PORT=8000
ENGINE_BACKEND=mock

# Dedicated single-user instance identity & modalities
ENGINE_INSTANCE_ID=local-instance
# Optional user ID pin; when empty, binds to the first authenticated user
ENGINE_USER_ID=
ENGINE_ENABLE_VOICE=true
ENGINE_ENABLE_VIDEO=true

# JWT verification (EdDSA / Ed25519) against apps/api
ENGINE_JWT_JWKS_URL=http://localhost:3001/.well-known/engine-jwks.json
ENGINE_JWT_JWKS_CACHE_TTL_S=300
ENGINE_JWT_ISSUER=http://localhost:3001
# Optional expected `aud` claim (apps/api mints `aud` = session/instance ID); leave empty for JWKS dev
ENGINE_JWT_AUDIENCE=

# Lifecycle timers & signed webhook callback to apps/api
ENGINE_STARTUP_IDLE_TIMEOUT_S=120
ENGINE_DISCONNECT_TIMEOUT_S=30
ENGINE_LIFECYCLE_WEBHOOK_URL=
ENGINE_LIFECYCLE_WEBHOOK_SECRET=

# Optional startup reference bootstrap & asset host allowlist (comma-separated)
ENGINE_INITIAL_PROMPT=
ENGINE_INITIAL_REF_IMAGE_URL=
ENGINE_INITIAL_REF_AUDIO_URL=
ENGINE_ALLOWED_ASSET_HOSTS=

# Video / Voice pipeline & A/V sync defaults
ENGINE_VIDEO_WIDTH=840
ENGINE_VIDEO_HEIGHT=480
ENGINE_VIDEO_FPS=24
ENGINE_VOICE_SAMPLE_RATE=22050
ENGINE_VOICE_VAD_BACKEND=rms
ENGINE_AV_SYNC_ENABLED=true

# Volume & model bootstrap (used by docker/entrypoint.sh)
MODEL_VOLUME_DIR=/models
MODEL_VOLUME_HOST_DIR=./models
AUTO_DOWNLOAD_MODELS=false
