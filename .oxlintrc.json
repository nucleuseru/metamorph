{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    ".venv/**",
    "dist/**",
    "build/**",
    ".turbo/**",
    ".next/**",
    "apps/web/.next/**",
    "node_modules/**",
    "vendor/**",
    ".agents/**",
    "**/.agents/**"
  ],
  "rules": {},
  "env": {
    "builtin": true
  }
}
