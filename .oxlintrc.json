{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    ".venv/**",
    "dist/**",
    "**/dist/**",
    "build/**",
    ".turbo/**",
    ".next/**",
    "apps/web/.next/**",
    "**/.react-email/**",
    "node_modules/**",
    "vendor/**",
    ".agents/**",
    "**/.agents/**"
  ],
  "overrides": [
    {
      "files": ["packages/email/**/*.{ts,tsx}"],
      "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y"],
      "rules": {
        "react/react-in-jsx-scope": "off"
      }
    },
    {
      "files": ["apps/web/**/*.{ts,tsx}"],
      "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "nextjs"],
      "rules": {
        "react/react-in-jsx-scope": "off"
      }
    }
  ],
  "settings": {
    "next": {
      "rootDir": ["apps/web"]
    }
  },
  "rules": {
    "no-underscore-dangle": ["warn", { "allow": ["_tag"] }],
    "unicorn/no-array-sort": "off"
  },
  "env": {
    "builtin": true
  }
}
