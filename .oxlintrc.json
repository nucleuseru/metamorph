{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    ".venv/**",
    "dist/**",
    "build/**",
    ".turbo/**",
    "node_modules/**",
    "vendor/**"
  ],
  "rules": {},
  "env": {
    "builtin": true
  }
}
