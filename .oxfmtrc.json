{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortImports": true,
  "sortTailwindcss": {
    "functions": ["cn", "cva"]
  },
  "overrides": [
    {
      "files": ["apps/web/**"],
      "options": {
        "sortTailwindcss": {
          "stylesheet": "./apps/web/src/app/globals.css",
          "functions": ["cn", "cva"]
        }
      }
    }
  ],
  "ignorePatterns": [
    ".venv/**",
    "dist/**",
    "**/dist/**",
    "build/**",
    ".turbo/**",
    ".next/**",
    "apps/web/.next/**",
    "**/.react-email/**",
    "node_modules/**",
    "vendor/**",
    ".agents/**",
    "**/.agents/**",
    "pnpm-lock.yaml",
    "uv.lock",
    "**/*.hbs"
  ]
}
